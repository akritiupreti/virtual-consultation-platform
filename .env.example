# Copy to .env and adjust for your local environment.
# .env is git-ignored; .env.example is committed as the canonical list of vars.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# Port the backend listens on INSIDE its process/container (always 3000 in Compose;
# the host-published port is BACKEND_PORT below). Locally, override if 3000 is taken.
PORT=3000

# ── Observability (Phase 5 — ADR-0013 logging, ADR-0014 metrics) ─────────────
# pino log level: trace|debug|info|warn|error|fatal (defaults: debug in dev, info in prod).
LOG_LEVEL=debug
# Human-readable pretty logs (true) vs raw JSON (false). Defaults to pretty off prod.
LOG_PRETTY=true
# Request/response header carrying the end-to-end correlation ID (SC-15).
CORRELATION_ID_HEADER=x-correlation-id

# ── PostgreSQL (must match docker-compose.yml) ──────────────────────────────
POSTGRES_USER=vcp
POSTGRES_PASSWORD=vcp_dev_password
POSTGRES_DB=vcp
# Host port Postgres is published on. Change if 5432 is already in use locally;
# keep DATABASE_URL's port in sync.
POSTGRES_PORT=5432
# Connection string used by Prisma (host is localhost from the host machine).
DATABASE_URL=postgresql://vcp:vcp_dev_password@localhost:5432/vcp?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# Use a long, random value in any non-local environment.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (Vite dev server default).
# NOTE: `docker compose` overrides this for the backend container to the
# containerised frontend's origin (http://localhost:${FRONTEND_PORT}).
CORS_ORIGIN=http://localhost:5173

# ── Docker Compose host ports (Phase 5 — full stack, SC-14) ──────────────────
# Host ports the containers are published on. Containers always use their internal
# ports (backend 3000, frontend 80); change these if a host port is already taken.
BACKEND_PORT=3100
FRONTEND_PORT=8088

# ── Domain configuration ─────────────────────────────────────────────────────
# Max active (IN_SESSION) consultations per clinician (requirements FR-10).
MAX_ACTIVE_CONSULTATIONS_PER_CLINICIAN=1
# Claim-start TTL (FR-12 / ADR-0010): a case CLAIMED but not started within this
# many seconds is auto-requeued. The sweeper runs every interval seconds.
CLAIM_START_TTL_SECONDS=120
CLAIM_TTL_SWEEP_INTERVAL_SECONDS=15

# ── Seed (local only) ────────────────────────────────────────────────────────
SEED_PASSWORD=Password123!

# ── Redis (Phase 3 — presence, pub/sub fan-out, cached positions; ADR-0004) ──
# Host port Redis is published on. Change if 6379 is already in use locally;
# keep REDIS_URL's port in sync.
REDIS_PORT=6379
# If unset, real-time degrades to single-instance in-memory mode (core flows
# unaffected). Set it to enable presence + cross-instance fan-out.
REDIS_URL=redis://localhost:6379

# ── Attachments (Phase 4 — ADR-0007: local object store + signed URLs) ───────
# Secret used to HMAC-sign short-lived download URLs. Falls back to JWT_SECRET if
# unset; use a long, random, SEPARATE value in any non-local environment.
ATTACHMENT_URL_SECRET=dev-only-change-me-attachments-secret
# How long a signed download URL is valid, in seconds (short-lived; NFR-2).
ATTACHMENT_URL_TTL_SECONDS=300
# Local directory for stored files (git-ignored; resolved from the backend cwd).
ATTACHMENT_STORAGE_DIR=./var/attachments
# Per-file size cap (bytes) and max files per consultation (C4 / FR-5).
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_CONSULTATION=10

# ── Input hardening & rate limiting (Phase 4 — ADR-0011) ─────────────────────
# Max JSON/urlencoded request body size (uploads use the attachment caps above).
JSON_BODY_LIMIT=100kb
# Rate limiting window (seconds) and limits. AUTH/UPLOAD are stricter per-route.
# Storage is in-memory by default; Redis-backed is the documented scale-out path.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
UPLOAD_THROTTLE_LIMIT=30
