# Copy to .env and adjust for your local environment.
# .env is git-ignored; .env.example is committed as the canonical list of vars.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (must match docker-compose.yml) ──────────────────────────────
POSTGRES_USER=vcp
POSTGRES_PASSWORD=vcp_dev_password
POSTGRES_DB=vcp
# Host port Postgres is published on. Change if 5432 is already in use locally;
# keep DATABASE_URL's port in sync.
POSTGRES_PORT=5432
# Connection string used by Prisma (host is localhost from the host machine).
DATABASE_URL=postgresql://vcp:vcp_dev_password@localhost:5432/vcp?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# Use a long, random value in any non-local environment.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# ── Domain configuration ─────────────────────────────────────────────────────
# Max active (IN_SESSION) consultations per clinician (requirements FR-10).
MAX_ACTIVE_CONSULTATIONS_PER_CLINICIAN=1

# ── Seed (local only) ────────────────────────────────────────────────────────
SEED_PASSWORD=Password123!

# ── Redis (introduced in Phase 3 — not used yet) ────────────────────────────
# REDIS_URL=redis://localhost:6379
